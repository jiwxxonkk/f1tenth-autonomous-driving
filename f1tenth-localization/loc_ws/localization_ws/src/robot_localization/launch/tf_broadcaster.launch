<launch>

<!-- base_link에서 imu로의 TF 변환 -->
<node pkg="tf2_ros" type="static_transform_publisher" name="base_link_to_imu" args="0.1 0 0 0 0 0 base_link imu" />

<!-- base_link에서 laser로의 TF 변환 -->
<node pkg="tf2_ros" type="static_transform_publisher" name="base_link_to_laser" args="0.3 0 0.18 0 0 0 base_link laser" />

</launch>
